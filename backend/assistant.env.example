# Copy the needed entries into your private backend/.env for local development.
# In Cloud Run, store secrets in Secret Manager and reference them as env vars.
ASSISTANT_ENABLED=false
PARALLEL_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
ADMIN_EMAIL=
# bcrypt hash, quoted in dotenv files to preserve dollar signs.
ADMIN_PASSWORD_HASH=
ASSISTANT_LUNA_MODEL=gpt-6-luna
ASSISTANT_GROK_MODEL=grok-4.7
ASSISTANT_MONTHLY_BUDGET_USD=20
# One direct Parallel Search API request per assignment, up to 10 results.
ASSISTANT_PARALLEL_SEARCH_MODE=fast
# Optional price override in USD/request. Unset: turbo/fast=0.001, basic/advanced=0.005.
# ASSISTANT_PARALLEL_SEARCH_USD_PER_REQUEST=0.001
ASSISTANT_LUNA_INPUT_USD_PER_M=0.10
ASSISTANT_LUNA_OUTPUT_USD_PER_M=0.50
ASSISTANT_GROK_INPUT_USD_PER_M=2
ASSISTANT_GROK_OUTPUT_USD_PER_M=6
# local: run npm run assistant:worker in a second backend terminal.
# cloud-tasks: Cloud Tasks invokes the authenticated worker HTTP endpoint.
ASSISTANT_QUEUE_MODE=local
ASSISTANT_TASK_QUEUE=
ASSISTANT_WORKER_URL=
ASSISTANT_WORKER_SECRET=
# Optional: public article-image bucket/CDN; no bucket access policy is changed.
ASSISTANT_IMAGE_BUCKET=
ASSISTANT_IMAGE_PUBLIC_BASE_URL=
