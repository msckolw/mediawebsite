{
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/build",
  "installCommand": "npm ci --prefix frontend",
  "framework": "create-react-app",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.thenobiasmedia.com"
        }
      ],
      "destination": "https://thenobiasmedia.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/page?route=/:path*"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "frontend/build/index.html"
    }
  }
}
