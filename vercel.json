{
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/build",
  "installCommand": "npm ci --prefix frontend",
  "framework": "create-react-app",
  "functions": {
    "api/page.js": {
      "includeFiles": "frontend/build/{index.html,prerendered.json}",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "www.thenobiasmedia.com"
        }
      ],
      "dest": "/api/page?route=/$1"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "dest": "/api/page?route=/"
    },
    {
      "src": "^/llms\\.txt$",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/page?route=/$1"
    }
  ]
}
